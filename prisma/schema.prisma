// StockFlow WMS — Prisma schema
//
// PHẠM VI FILE NÀY (đọc trước khi thêm model):
//   Chỉ chứa 2 thực thể lõi mà SRS §5.2 ĐẶC TẢ ĐẦY ĐỦ tới từng cột:
//   SoDuTonKho (§5.2.1) và ChuyenDongKho (§5.2.2).
//   SRS §5.1 liệt kê 36 thực thể; 34 thực thể còn lại CHƯA có đặc tả cột nên
//   KHÔNG được mô hình hoá ở đây — chúng thuộc phần việc của SA/BA (ADR + shard
//   spec) để tránh tự phát minh cấu trúc dữ liệu.
//
//   Vì các thực thể được tham chiếu (SanPham, ViTri, Lo, SerialItem) chưa tồn
//   tại, các khoá ngoại tới chúng vẫn là cột BigInt trần, chưa có quan hệ Prisma.
//   Khi SA mô hình hoá xong, thay bằng @relation.
//
//   CẬP NHẬT 2026-08-20 (WMS-2, ADR-0003): nhóm DANH TÍNH đã được mô hình hoá —
//   NguoiDung, VaiTro, Quyen, Kho, Phien, NhatKyThaoTac cùng 3 bảng nối. Đường
//   đi hợp lệ là ADR trước, lược đồ sau, đúng như luật ở trên đòi. Mỗi cột trong
//   nhóm đó truy được về một yêu cầu; chỗ nào không truy được thì không có cột
//   (xem docs/adr/0003-mo-hinh-du-lieu-danh-tinh.md).
//
// Ràng buộc hạ tầng (SRS §2.3 + OPN-03 CHƯA CHỐT):
//   SRS chỉ yêu cầu "RDBMS hỗ trợ ACID, cô lập tối thiểu READ COMMITTED, khoá
//   bản ghi tường minh". PostgreSQL là lựa chọn mặc định của base này và cần
//   một ADR xác nhận khi OPN-03 được quyết định.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: URL kết nối KHÔNG còn khai báo ở đây.
//   - Migrate/introspect đọc từ prisma.config.ts
//   - Runtime dùng driver adapter (@prisma/adapter-pg) — xem src/lib/prisma.ts
datasource db {
  provider = "postgresql"
}

/// SRS §5.2.1 — Số dư tồn kho.
/// RSK-K03: số dư nằm ở bảng tổng hợp riêng, tách khỏi sổ chuyển động, và phải
/// được cập nhật trong CÙNG giao dịch với ChuyenDongKho (DC-05).
model SoDuTonKho {
  id              BigInt   @id @default(autoincrement())
  sanPhamId       BigInt   @map("san_pham_id")
  /// SRS §5.2.1 gọi thẳng "Khóa ngoại tới Kho". Kho đã tồn tại từ WMS-2 nên
  /// luật ở đầu file ("khi SA mô hình hoá xong, thay bằng @relation") đến hạn.
  khoId           BigInt   @map("kho_id")
  viTriId         BigInt   @map("vi_tri_id")
  /// Bắt buộc khi sản phẩm truy vết theo lô.
  loId            BigInt?  @map("lo_id")

  soLuongThucTe   Decimal  @map("so_luong_thuc_te")  @db.Decimal(18, 3)
  soLuongPhanBo   Decimal  @map("so_luong_phan_bo")  @db.Decimal(18, 3) @default(0)
  soLuongChoQc    Decimal  @map("so_luong_cho_qc")   @db.Decimal(18, 3)
  soLuongCachLy   Decimal  @map("so_luong_cach_ly")  @db.Decimal(18, 3)
  soLuongKhoa     Decimal  @map("so_luong_khoa")     @db.Decimal(18, 3)
  /// Cột dẫn xuất theo công thức BRULE-11, duy trì đồng bộ.
  soLuongKhaDung  Decimal  @map("so_luong_kha_dung") @db.Decimal(18, 3)

  /// @updatedAt chỉ được Prisma client đặt. Không có @default thì mọi INSERT
  /// bằng SQL thuần (migration, seed, tác vụ đối soát của DI-03) đều 23502.
  /// Test tích hợp WMS-2 phát hiện; lỗi này có từ trước WMS-2.
  capNhatLuc      DateTime @map("cap_nhat_luc") @default(now()) @updatedAt @db.Timestamptz(3)
  /// Kiểm soát tương tranh lạc quan.
  phienBan        Int      @map("phien_ban") @default(0)

  kho             Kho      @relation(fields: [khoId], references: [id], onDelete: Restrict)

  // BRULE-12 (mọi cột số lượng >= 0) là CHECK constraint — Prisma không sinh
  // được, phải thêm bằng SQL thủ công trong migration đầu tiên.
  @@unique([sanPhamId, khoId, viTriId, loId])
  @@map("so_du_ton_kho")
}

/// SRS §5.2.2 — Sổ chuyển động kho. CHỈ GHI THÊM (append-only).
/// BRULE-13 / RSK-P01: quyền UPDATE và DELETE phải bị THU HỒI ở cấp tài khoản
/// DB của ứng dụng — Prisma không cưỡng chế được, phải làm bằng GRANT trong
/// migration. Bảng phân vùng theo tháng (chưa cấu hình được: chờ OPN-03).
model ChuyenDongKho {
  id               BigInt   @id @default(autoincrement())
  /// NHAP | XUAT | CHUYEN_DI | CHUYEN_DEN | DIEU_CHINH | KIEM_KE | TRA_VE | CAT_HANG
  /// SRS đặc tả VARCHAR(30), không phải enum DB — giữ nguyên kiểu.
  loaiGiaoDich     String   @map("loai_giao_dich") @db.VarChar(30)

  sanPhamId        BigInt   @map("san_pham_id")
  khoId            BigInt   @map("kho_id")
  viTriId          BigInt   @map("vi_tri_id")
  loId             BigInt?  @map("lo_id")
  /// Bắt buộc khi sản phẩm truy vết theo serial.
  serialItemId     BigInt?  @map("serial_item_id")

  /// Dương là tăng, âm là giảm.
  soLuong          Decimal  @map("so_luong")   @db.Decimal(18, 3)
  tonTruoc         Decimal  @map("ton_truoc")  @db.Decimal(18, 3)
  tonSau           Decimal  @map("ton_sau")    @db.Decimal(18, 3)

  /// Tham chiếu đa hình tới chứng từ nguồn.
  loaiChungTu      String   @map("loai_chung_tu") @db.VarChar(30)
  chungTuId        BigInt   @map("chung_tu_id")
  /// Bắt buộc với giao dịch loại DIEU_CHINH.
  lyDoId           BigInt?  @map("ly_do_id")

  /// Sổ kho bất biến mà không đọc được "ai làm" thì vô dụng với ST-15: khoá
  /// ngoại RESTRICT chặn việc xoá người dùng còn dấu vết trong sổ.
  nguoiThucHienId  BigInt   @map("nguoi_thuc_hien_id")
  /// Thời điểm phát sinh — không thể sửa.
  thoiDiem         DateTime @map("thoi_diem") @db.Timestamptz(3)

  kho              Kho       @relation(fields: [khoId],           references: [id], onDelete: Restrict)
  nguoiThucHien    NguoiDung @relation(fields: [nguoiThucHienId], references: [id], onDelete: Restrict)

  @@index([sanPhamId, khoId, thoiDiem])
  @@index([loaiChungTu, chungTuId])
  @@map("chuyen_dong_kho")
}


// ════════════════════════════════════════════════════════════════════════════
// NHÓM DANH TÍNH — WMS-2 · ADR-0003
//
// VÌ SAO KHÔNG CÓ CỘT "AI TẠO / AI SỬA" trên các bảng này:
// Luật cột kiểm toán của BA là "ai / khi nào". Nửa "khi nào" nằm ở tao_luc và
// cap_nhat_luc. Nửa "ai" KHÔNG lặp lại thành cột, vì FR-20-09 đã bắt ghi nhật ký
// mọi hành động tạo/sửa/xoá kèm người thực hiện, thời điểm, IP, giá trị trước và
// sau — nhat_ky_thao_tac là house of record cho câu hỏi đó. Thêm nguoi_tao_id
// vào từng bảng là chép một sự thật ra hai chỗ, và hai chỗ đó sẽ lệch nhau.
// (Bản đầu bỏ nửa "ai" mà không nói lý do; reviewer R1 bắt được.)
// SRS §5.1 có liệt kê những thực thể này nhưng §5.2 KHÔNG đặc tả cột, nên nguồn
// suy ra của TỪNG cột được ghi ngay tại chỗ. Không cột nào ở đây "cho chắc".
// ════════════════════════════════════════════════════════════════════════════

/// SRS §5.1 — Kho vật lý. CỐ Ý TỐI THIỂU: WMS-2 chỉ cần Kho làm đích cho phạm vi
/// kho của BR-22. Cấu trúc bốn cấp (Kho → Khu vực → Kệ → Ô chứa) và quy tắc sinh
/// mã vị trí thuộc SC-06 và còn chờ TBD-01 — thêm cột bây giờ là phát minh, và
/// sẽ va vào thiết kế thật của SC-06. ViTri KHÔNG được tạo ở đây.
model Kho {
  id            BigInt   @id @default(autoincrement())
  /// FR-06-02 dùng mã kho làm tiền tố mã vị trí ⇒ mã phải duy nhất.
  ma            String   @unique @db.VarChar(20)
  ten           String   @db.VarChar(200)
  /// Nguồn ĐÚNG là ràng buộc SC-06: "mỗi kho phải có tối thiểu một vị trí Tiếp
  /// nhận và một vị trí Cách ly TRƯỚC KHI ĐƯỢC KÍCH HOẠT" — tức kho có trạng
  /// thái hoạt động. (Bản đầu dẫn nhầm FR-20-01, vốn nói về tài khoản người
  /// dùng, và DI-07, vốn nói về chứng từ. Reviewer R1 bắt được.)
  dangHoatDong  Boolean  @map("dang_hoat_dong") @default(true)
  taoLuc        DateTime @map("tao_luc")   @default(now()) @db.Timestamptz(3)
  capNhatLuc    DateTime @map("cap_nhat_luc") @default(now()) @updatedAt @db.Timestamptz(3)

  nguoiDungKho  NguoiDungKho[]
  phien         Phien[]
  soDuTonKho    SoDuTonKho[]
  chuyenDongKho ChuyenDongKho[]

  @@map("kho")
}

/// SRS §5.1 — Vai trò và ma trận quyền. §8 định nghĩa 9 vai trò mặc định;
/// FR-20-03 đòi chúng phải sao chép và điều chỉnh được, nên `laMacDinh` phân biệt
/// vai trò hệ thống dựng sẵn với vai trò do quản trị tạo (FR-20-02).
model VaiTro {
  id           Int      @id @default(autoincrement())
  /// Mã viết tắt theo §8: QTHT, QLK, TK, NVK, QC, MH, KD, KT, CSKH.
  ma           String   @unique @db.VarChar(20)
  ten          String   @db.VarChar(100)
  laMacDinh    Boolean  @map("la_mac_dinh") @default(false)
  taoLuc       DateTime @map("tao_luc") @default(now()) @db.Timestamptz(3)

  quyen        VaiTroQuyen[]
  nguoiDung    NguoiDungVaiTro[]

  @@map("vai_tro")
}

/// FR-20-02 — quyền là tổ hợp MÀN HÌNH × HÀNH ĐỘNG, không phải enum.
/// Lý do là enum: mỗi màn hình mới sẽ thành một migration, trong khi FR-20-02
/// bắt quản trị định nghĩa vai trò tuỳ chỉnh LÚC CHẠY. Danh mục do người dùng
/// quản lý ⇒ bảng lookup (luật vựng dữ liệu trong docs/team/roles/ba.md).
model Quyen {
  id        Int    @id @default(autoincrement())
  /// Mã màn hình theo SRS: SC-01 … SC-20.
  manHinh   String @map("man_hinh") @db.VarChar(10)
  /// FR-20-02 liệt kê đúng 6 hành động: XEM TAO SUA XOA PHE_DUYET KET_XUAT.
  hanhDong  String @map("hanh_dong") @db.VarChar(20)

  vaiTro    VaiTroQuyen[]

  @@unique([manHinh, hanhDong])
  @@map("quyen")
}

model VaiTroQuyen {
  vaiTroId Int @map("vai_tro_id")
  quyenId  Int @map("quyen_id")

  vaiTro   VaiTro @relation(fields: [vaiTroId], references: [id], onDelete: Cascade)
  quyen    Quyen  @relation(fields: [quyenId],  references: [id], onDelete: Cascade)

  @@id([vaiTroId, quyenId])
  @@map("vai_tro_quyen")
}

/// SRS §5.1 — Tài khoản người dùng, n–n với VaiTro và Kho.
/// Mỗi cột dưới đây gắn với một yêu cầu; không có cột dự phòng.
model NguoiDung {
  id                BigInt    @id @default(autoincrement())
  /// FR-01-01: đăng nhập bằng tên đăng nhập HOẶC email nội bộ ⇒ cả hai đều unique.
  tenDangNhap       String    @unique @map("ten_dang_nhap") @db.VarChar(50)
  email             String    @unique @db.VarChar(200)
  hoTen             String    @map("ho_ten") @db.VarChar(200)
  /// NFR-SEC-03: CHỈ băm (bcrypt/scrypt/Argon2). Không cột nào ở đây hai chiều.
  matKhauHash       String    @map("mat_khau_hash") @db.VarChar(255)
  /// FR-01-04: null = chưa từng đổi ⇒ buộc đổi ở lần đăng nhập đầu; quá 90 ngày
  /// ⇒ buộc đổi định kỳ. Một cột trả lời cả hai vế, không cần cờ riêng.
  matKhauDoiLuc     DateTime? @map("mat_khau_doi_luc") @db.Timestamptz(3)
  /// FR-20-01 vô hiệu hoá tài khoản. ADR-0002 đọc cờ này TRONG cùng lượt đọc
  /// phiên ⇒ NFR-SEC-08 (hiệu lực ≤2 phút) đạt ở mức 0 phút.
  dangHoatDong      Boolean   @map("dang_hoat_dong") @default(true)
  /// FR-01-02: khoá 30 phút sau 5 lần sai liên tiếp TRONG 15 phút. Cần cả mốc
  /// lần sai đầu (để biết cửa sổ 15 phút) lẫn mốc hết khoá.
  soLanSaiLienTiep  Int       @map("so_lan_sai_lien_tiep") @default(0)
  saiDauTienLuc     DateTime? @map("sai_dau_tien_luc") @db.Timestamptz(3)
  khoaDenLuc        DateTime? @map("khoa_den_luc") @db.Timestamptz(3)

  taoLuc            DateTime  @map("tao_luc") @default(now()) @db.Timestamptz(3)
  capNhatLuc        DateTime  @map("cap_nhat_luc") @default(now()) @updatedAt @db.Timestamptz(3)

  vaiTro            NguoiDungVaiTro[]
  kho               NguoiDungKho[]
  phien             Phien[]
  nhatKy            NhatKyThaoTac[]
  chuyenDongKho     ChuyenDongKho[]

  @@map("nguoi_dung")
}

model NguoiDungVaiTro {
  nguoiDungId BigInt @map("nguoi_dung_id")
  vaiTroId    Int    @map("vai_tro_id")

  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  vaiTro      VaiTro    @relation(fields: [vaiTroId],    references: [id], onDelete: Restrict)

  @@id([nguoiDungId, vaiTroId])
  @@map("nguoi_dung_vai_tro")
}

/// BR-22 — phạm vi kho là DỮ LIỆU, không phải quy ước. NFR-SEC-04 bắt thực thi ở
/// tầng máy chủ cho mọi điểm cuối, nên nó phải tra được bằng một câu truy vấn.
model NguoiDungKho {
  nguoiDungId BigInt @map("nguoi_dung_id")
  khoId       BigInt @map("kho_id")

  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id], onDelete: Cascade)
  kho         Kho       @relation(fields: [khoId],       references: [id], onDelete: Restrict)

  @@id([nguoiDungId, khoId])
  @@map("nguoi_dung_kho")
}

/// ADR-0002 §Quyết định 1 — thực thể này KHÔNG có trong SRS §5.1; nó là thứ
/// ADR-0002 thêm vào để thoả đồng thời FR-01-07 (hết phiên 30 phút) và NFR-SEC-08
/// (thu hồi ≤2 phút), điều mà token tự chứa không làm được. Delta đã ghi ở
/// docs/specs/changes.md.
model Phien {
  /// Mã phiên ngẫu nhiên đủ entropy (ADR-0002). Không dùng số tăng dần: mã phiên
  /// đoán được là mã phiên mượn được.
  id               String    @id @db.VarChar(64)
  nguoiDungId      BigInt    @map("nguoi_dung_id")
  /// FR-01-06 — kho làm việc là trạng thái CỦA PHIÊN, không của tài khoản.
  /// Null hợp lệ trong khoảnh khắc sau đăng nhập, trước khi người dùng chọn kho.
  khoHienTaiId     BigInt?   @map("kho_hien_tai_id")
  taoLuc           DateTime  @map("tao_luc") @default(now()) @db.Timestamptz(3)
  /// ADR-0002 §Quyết định 3: gộp ghi mỗi 60 giây ⇒ ngưỡng 30 phút của FR-01-07
  /// chính xác tới ±60 giây. Đây là đánh đổi đã ghi, không phải lỗi.
  thaoTacCuoiLuc   DateTime  @map("thao_tac_cuoi_luc") @default(now()) @db.Timestamptz(3)
  hetHanLuc        DateTime  @map("het_han_luc") @db.Timestamptz(3)
  /// FR-01-08 ghi IP mỗi lần đăng nhập.
  diaChiIp         String    @map("dia_chi_ip") @db.Inet

  nguoiDung        NguoiDung @relation(fields: [nguoiDungId],  references: [id], onDelete: Cascade)
  kho              Kho?      @relation(fields: [khoHienTaiId], references: [id], onDelete: Restrict)

  /// Dọn phiên hết hạn quét theo cột này (ADR-0002 §Hệ quả).
  @@index([hetHanLuc])
  @@map("phien")
}

/// SRS §5.1 — Nhật ký kiểm toán mọi thao tác, CHỈ GHI THÊM.
/// PB-07: hiện trạng không có nhật ký nào nên khi tồn lệch không ai chứng minh
/// được ai sửa gì; ST-15 (kiểm toán nội bộ) cần truy vết theo người/thời gian/lý do.
/// Quyền UPDATE và DELETE bị THU HỒI trong migration — cùng cơ chế BRULE-13 dùng
/// cho chuyen_dong_kho. Một nhật ký sửa được thì không phải nhật ký.
model NhatKyThaoTac {
  id                 BigInt   @id @default(autoincrement())
  /// NULLABLE có chủ ý. FR-01-08 bắt ghi nhật ký MỌI lần đăng nhập thất bại,
  /// kể cả khi tên đăng nhập không tồn tại — mà đó chính là trường hợp phổ biến
  /// nhất, và là trường hợp ràng buộc chống dò tài khoản của SC-01 buộc phải xử
  /// lý. NOT NULL + khoá ngoại thì dòng đó không ghi được, và bảng chỉ-ghi-thêm
  /// nên không vá bằng dữ liệu sau. Cột ten_dang_nhap_luc_ghi vẫn luôn có giá
  /// trị, nên "ai đã thử" không mất.
  nguoiDungId        BigInt?  @map("nguoi_dung_id")
  /// Lịch sử KHÔNG được viết lại: đổi tên đăng nhập sau này không được làm đổi
  /// bản ghi cũ. Khoá ngoại trả lời "ai", cột này trả lời "lúc đó họ tên gì".
  tenDangNhapLucGhi  String   @map("ten_dang_nhap_luc_ghi") @db.VarChar(50)
  /// FR-20-09: tạo, sửa, xoá, phê duyệt, kết xuất. FR-01-08 thêm đăng nhập
  /// thành công và thất bại.
  hanhDong           String   @map("hanh_dong") @db.VarChar(30)
  loaiDoiTuong       String   @map("loai_doi_tuong") @db.VarChar(50)
  doiTuongId         BigInt?  @map("doi_tuong_id")
  /// FR-20-09 đòi giá trị TRƯỚC và SAU. NFR-SEC-09 cấm ghi mật khẩu, khoá API,
  /// dữ liệu cá nhân đầy đủ vào nhật ký — lọc ở tầng ứng dụng.
  giaTriTruoc        Json?    @map("gia_tri_truoc")
  giaTriSau          Json?    @map("gia_tri_sau")
  diaChiIp           String   @map("dia_chi_ip") @db.Inet
  thoiDiem           DateTime @map("thoi_diem") @default(now()) @db.Timestamptz(3)

  nguoiDung          NguoiDung? @relation(fields: [nguoiDungId], references: [id], onDelete: Restrict)

  /// FR-20-11: tìm theo người dùng, khoảng thời gian, loại đối tượng, mã chứng từ
  /// — dưới 5 giây trên dữ liệu 12 tháng.
  @@index([nguoiDungId, thoiDiem])
  @@index([loaiDoiTuong, doiTuongId])
  @@index([thoiDiem])
  @@map("nhat_ky_thao_tac")
}
