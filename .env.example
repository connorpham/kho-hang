# StockFlow WMS — sao chép sang .env rồi điền giá trị thật. .env KHÔNG bao giờ commit.

# ── Cơ sở dữ liệu ──────────────────────────────────────────────────────────
# PostgreSQL. SRS §2.3 yêu cầu ACID + cô lập tối thiểu READ COMMITTED + khoá
# bản ghi tường minh. Hạ tầng cụ thể chờ quyết định OPN-03.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow_wms?schema=public"
# DB nháp cho Prisma Migrate phát hiện drift (bắt buộc khi migration có SQL thủ công).
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stockflow_wms_shadow?schema=public"

# ── Jira (vteam tracker) ───────────────────────────────────────────────────
# project.key trong vteam.config.yaml là WMS → Jira project phải có key WMS.
JIRA_BASE_URL="https://your-company.atlassian.net"
JIRA_EMAIL="phamcong6499@gmail.com"
JIRA_API_TOKEN=""
